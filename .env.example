# ============================================
# OpenAI (Function Calling baseline)
# ============================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Google Gemini (Function Calling baseline)
# ============================================
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# Alibaba Cloud (translation + QA + reasoning)
# Lưu ý: dùng OpenAI-compatible API, KHÔNG dùng dashscope SDK
# ============================================
ALIBABA_API_KEY=sk-...
ALIBABA_MODEL=qwen3.7-flash-2026-07-15
ALIBABA_QA_MODEL=qwen3.7-max
ALIBABA_URL=https://<region>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#
# Available models (cùng endpoint, chỉ đổi model name):
#   - qwen3.7-flash-2026-07-15   (general, free — mặc định translation)
#   - qwen3.7-max                (powerful — mặc định QA judge)
#   - qwen-mt-plus               (translation-specialized)
#   - deepseek-v3                (reasoning)

# ============================================
# Hugging Face (optional — 2 dataset chính public, không bắt buộc)
# ============================================
HF_TOKEN=hf_...
HF_HOME=./.cache/huggingface

# ============================================
# Logging / wandb (optional)
# ============================================
WANDB_API_KEY=
WANDB_PROJECT=tool-calling-vi
WANDB_ENTITY=
