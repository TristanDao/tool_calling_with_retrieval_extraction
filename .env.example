# OpenAI (Function Calling baseline)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (Function Calling baseline)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# Alibaba DashScope (Qwen-MT translation)
DASHSCOPE_API_KEY=sk-...
QWEN_MT_MODEL=qwen-mt-plus

# Hugging Face
HF_TOKEN=hf_...
HF_HOME=./.cache/huggingface

# Local LLM serving (vLLM / Ollama)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Logging / wandb (optional)
WANDB_API_KEY=
WANDB_PROJECT=tool-calling-vi
WANDB_ENTITY=
