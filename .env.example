# ============================================
# OpenAI (Function Calling baseline)
# ============================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Google Gemini (Function Calling baseline)
# ============================================
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# Alibaba Cloud (translation + QA + reasoning)
# Lưu ý: dùng OpenAI-compatible API, KHÔNG dùng dashscope SDK
# ============================================
ALIBABA_API_KEY=sk-...
ALIBABA_MODEL=qwen-mt-plus
ALIBABA_BACKUP_MODELS=qwen-mt-turbo,qwen-mt-flash,qwen-mt-lite,qwen3.7-max,qwen3.8-max,qwen3-max,...
ALIBABA_URL=https://<region>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#
# Fallback chain: 74 models ordered by quality tier:
#   Tier 1 (MT): qwen-mt-plus, qwen-mt-turbo, qwen-mt-flash, qwen-mt-lite
#   Tier 2 (Max/Plus): qwen3.7-max, qwen3.8-max, qwen3-max, qwen3.7-plus, qwen3.6-plus, ...
#   Tier 3 (Flash): qwen3.7-flash, qwen3.6-flash, qwen3.5-flash, qwen-flash
#   Tier 4 (Mid-size): qwen3-32b, qwen3-14b, qwen3-8b, ...
#   Tier 5 (VL): qwen3-vl-plus, qwen3-vl-flash, qwen-vl-plus, qwen-vl-max
#   Tier 6 (Coder): qwen3-coder-next, qwen3-coder-plus, qwen3-coder-flash, ...
#   Tier 7 (DeepSeek): deepseek-v3.2, deepseek-v4-flash, deepseek-v4-pro
#
# Daily budget: 74 models x 1M tokens = ~74M tokens/day
# 105k samples x ~3k tokens = ~315M tokens -> ~4.5 days
#
# Per-run model override (không cần sửa .env):
#   MODEL=qwen3.7-max bash scripts/data/run_translate_glaive.sh 0 1000

# ============================================
# Hugging Face (optional — 2 dataset chính public, không bắt buộc)
# ============================================
HF_TOKEN=hf_...
HF_HOME=./.cache/huggingface

# ============================================
# Logging / wandb (optional)
# ============================================
WANDB_API_KEY=
WANDB_PROJECT=tool-calling-vi
WANDB_ENTITY=
